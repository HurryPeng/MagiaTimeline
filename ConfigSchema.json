{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://magiatimeline.tech/schemas/ConfigSchema.json",
    "title": "MagiaTimeline Configuration Schema",
    "$defs": {
        "ratio": {
            "description": "a nuber between 0 and 1 representing a relative width or height in a frame",
            "type": "number",
            "minimum": 0,
            "maximum": 1
        },
        "ratioRectangle": {
            "description": "a rectangular area in a frame described by ratios of [left, right, top, bottom]",
            "type": "array",
            "items": [
                {
                    "$ref": "#/$defs/ratio"
                },
                {
                    "$ref": "#/$defs/ratio"
                },
                {
                    "$ref": "#/$defs/ratio"
                },
                {
                    "$ref": "#/$defs/ratio"
                }
            ],
            "minItems": 4,
            "maxItems": 4,
            "additionalItems": false
        },
        "HSVRange": {
            "description": "HSV range for color detection",
            "type": "array",
            "items": [
                {
                    "description": "Hmin",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 180
                },
                {
                    "description": "Smin",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                },
                {
                    "description": "Vmin",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                },
                {
                    "description": "Hmax",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 180
                },
                {
                    "description": "Smax",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                },
                {
                    "description": "Vmax",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                }
            ],
            "additionalItems": false
        }
    },
    "type": "object",
    "properties": {
        "source": {
            "description": "path(s) of source video files",
            "type": "array",
            "items": {
                "type": "string"
            },
            "minLength": 1
        },
        "destination": {
            "description": "path(s) of destination subtitle files with no extension",
            "type": "array",
            "items": {
                "type": "string"
            },
            "minLength": 1
        },
        "outputSrt": {
            "description": "whether to additionally output an SRT file alongside the always-generated ASS file; SRT loses style information",
            "type": "boolean"
        },
        "assTemplate": {
            "description": "template ass file defining the header of destination ass file, in asst format; required when outputFormat is 'ass'",
            "type": "string"
        },
        "enableOpenCL": {
            "description": "enable OpenCL acceleration",
            "type": "boolean"
        },
        "contentRect": {
            "description": "defines the rectangle that wraps the content of a frame, cutting away black bars around",
            "$ref": "#/$defs/ratioRectangle"
        },
        "maxResWidth": {
            "description": "if the video width exceeds this value, both dimensions will be halved until within limits. Set to 0 to disable.",
            "type": "integer",
            "minimum": 0
        },
        "maxResHeight": {
            "description": "if the video height exceeds this value, both dimensions will be halved until within limits. Set to 0 to disable. Keep lower than maxResWidth to aggressively downsample portrait videos.",
            "type": "integer",
            "minimum": 0
        },
        "strategy": {
            "description": "which algorithm set to use",
            "enum": [
                "mr",
                "mr-s0",
                "md",
                "lcb",
                "lcb-mech",
                "pkm",
                "prk",
                "bdr",
                "otl",
                "bcs",
                "dtd"
            ]
        },
        "preset": {
            "description": "which preset of parameters under a strategy to use",
            "type": "string"
        },
        "mr": {
            "description": "MagiaRecord quest video",
            "type": "object",
            "patternProperties": {
                ".*": {
                    "description": "a preset for strategy mr",
                    "type": "object",
                    "properties": {
                        "dialogOutlineRect": {
                            "$ref": "#/$defs/ratioRectangle"
                        },
                        "dialogBgRect": {
                            "$ref": "#/$defs/ratioRectangle"
                        },
                        "blackscreenRect": {
                            "$ref": "#/$defs/ratioRectangle"
                        },
                        "whitescreenRect": {
                            "$ref": "#/$defs/ratioRectangle"
                        },
                        "cgSubAboveRect": {
                            "$ref": "#/$defs/ratioRectangle"
                        },
                        "cgSubBorderRect": {
                            "$ref": "#/$defs/ratioRectangle"
                        },
                        "cgSubBelowRect": {
                            "$ref": "#/$defs/ratioRectangle"
                        },
                        "cgSubTextRect": {
                            "$ref": "#/$defs/ratioRectangle"
                        }
                    },
                    "required": [
                        "dialogOutlineRect",
                        "dialogBgRect",
                        "blackscreenRect",
                        "whitescreenRect",
                        "cgSubAboveRect",
                        "cgSubBorderRect",
                        "cgSubBelowRect",
                        "cgSubTextRect"
                    ],
                    "additionalProperties": false
                }
            }
        },
        "mr-s0": {
            "description": "MagiaRecord Scene0 film",
            "type": "object",
            "patternProperties": {
                ".*": {
                    "description": "a preset for strategy mr",
                    "type": "object",
                    "properties": {
                        "dialogRect": {
                            "$ref": "#/$defs/ratioRectangle"
                        },
                        "blackscreenRect": {
                            "$ref": "#/$defs/ratioRectangle"
                        }
                    },
                    "required": [
                        "dialogRect",
                        "blackscreenRect"
                    ],
                    "additionalProperties": false
                }
            }
        },
        "md": {
            "description": "MagiaExedra quest video",
            "type": "object",
            "patternProperties": {
                ".*": {
                    "description": "a preset for strategy md",
                    "type": "object",
                    "properties": {
                        "homeDialogRect": {
                            "$ref": "#/$defs/ratioRectangle"
                        },
                        "underHomeDialogRect": {
                            "$ref": "#/$defs/ratioRectangle"
                        },
                        "dialogRect": {
                            "$ref": "#/$defs/ratioRectangle"
                        },
                        "whitescreenRect": {
                            "$ref": "#/$defs/ratioRectangle"
                        },
                        "blackscreenRect": {
                            "$ref": "#/$defs/ratioRectangle"
                        },
                        "leftBubbleRect": {
                            "$ref": "#/$defs/ratioRectangle"
                        },
                        "rightBubbleRect": {
                            "$ref": "#/$defs/ratioRectangle"
                        }
                    },
                    "required": [
                        "homeDialogRect",
                        "underHomeDialogRect",
                        "dialogRect",
                        "whitescreenRect",
                        "blackscreenRect",
                        "leftBubbleRect",
                        "rightBubbleRect"
                    ],
                    "additionalProperties": false
                }
            }
        },
        "lcb": {
            "description": "LimbusCompany quest video",
            "type": "object",
            "patternProperties": {
                ".*": {
                    "type": "object",
                    "description": "a preset for strategy lcb",
                    "properties": {
                        "dialogRect": {
                            "$ref": "#/$defs/ratioRectangle"
                        }
                    },
                    "required": [
                        "dialogRect"
                    ],
                    "additionalProperties": false
                }
            }
        },
        "lcb-mech": {
            "description": "LimbusCompany mechanics introduction video",
            "type": "object",
            "patternProperties": {
                ".*": {
                    "type": "object",
                    "description": "a preset for strategy lcb-mech",
                    "properties": {
                        "dialogRect": {
                            "$ref": "#/$defs/ratioRectangle"
                        }
                    },
                    "required": [
                        "dialogRect"
                    ],
                    "additionalProperties": false
                }
            }
        },
        "pkm": {
            "description": "PekemonEmerald video",
            "type": "object",
            "patternProperties": {
                ".*": {
                    "description": "a preset for strategy pkm",
                    "type": "object",
                    "properties": {
                        "dialogBgRect": {
                            "$ref": "#/$defs/ratioRectangle"
                        }
                    },
                    "required": [
                        "dialogBgRect"
                    ],
                    "additionalProperties": false
                }
            }
        },
        "prk": {
            "description": "Parako anime conte",
            "type": "object",
            "patternProperties": {
                ".*": {
                    "description": "a preset for strategy prk",
                    "type": "object",
                    "properties": {
                        "dialogRect": {
                            "$ref": "#/$defs/ratioRectangle"
                        }
                    },
                    "required": [
                        "dialogRect"
                    ],
                    "additionalProperties": false
                }
            }
        },
        "bdr": {
            "description": "BanG Dream story video",
            "type": "object",
            "patternProperties": {
                ".*": {
                    "description": "a preset for strategy bdr",
                    "type": "object",
                    "properties": {
                        "dialogRect": {
                            "$ref": "#/$defs/ratioRectangle"
                        },
                        "jumpThreshDist": {
                            "description": "threshold distance for jump detection",
                            "type": "number",
                            "minimum": 0
                        },
                        "fillGapMaxGap": {
                            "description": "maximum gap in milliseconds to fill",
                            "type": "integer",
                            "minimum": 0
                        },
                        "fillGapMeetPoint": {
                            "description": "meeting point ratio for filling gaps",
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "bgMinBrightness": {
                            "description": "minimum brightness for background",
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 255
                        },
                        "bgMaxBrightness": {
                            "description": "maximum brightness for background",
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 255
                        },
                        "bgMinMeanVal": {
                            "description": "minimum mean value for background",
                            "type": "number",
                            "minimum": 0,
                            "maximum": 255
                        },
                        "bgMaxMeanVal": {
                            "description": "maximum mean value for background",
                            "type": "number",
                            "minimum": 0,
                            "maximum": 255
                        },
                        "textMinBrightness": {
                            "description": "minimum brightness for text",
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 255
                        },
                        "textMaxBrightness": {
                            "description": "maximum brightness for text",
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 255
                        },
                        "textMinMeanVal": {
                            "description": "minimum mean value for text",
                            "type": "number",
                            "minimum": 0,
                            "maximum": 255
                        },
                        "textMaxMeanVal": {
                            "description": "maximum mean value for text",
                            "type": "number",
                            "minimum": 0,
                            "maximum": 255
                        }
                    },
                    "required": [
                        "dialogRect",
                        "jumpThreshDist",
                        "fillGapMaxGap",
                        "fillGapMeetPoint",
                        "bgMinBrightness",
                        "bgMaxBrightness",
                        "bgMinMeanVal",
                        "bgMaxMeanVal",
                        "textMinBrightness",
                        "textMaxBrightness",
                        "textMinMeanVal",
                        "textMaxMeanVal"
                    ],
                    "additionalProperties": false
                }
            }
        },
        "otl": {
            "description": "Outlined text",
            "type": "object",
            "patternProperties": {
                ".*": {
                    "description": "a preset for strategy otl",
                    "type": "object",
                    "properties": {
                        "dialogRect": {
                            "description": "rectangle of the detected dialog area",
                            "$ref": "#/$defs/ratioRectangle"
                        },
                        "fastMode": {
                            "description": "fast mode skips boundary detection for speed but may reduce accuracy",
                            "type": "boolean"
                        },
                        "textWeightMin": {
                            "description": "minimum weight for areas to be considered as text",
                            "type": "integer",
                            "minimum": 0
                        },
                        "textWeightMax": {
                            "description": "maximum weight for areas to be considered as text",
                            "type": "integer",
                            "minimum": 0
                        },
                        "textHSVRanges": {
                            "description": "HSV ranges for areas to be considered as text",
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/HSVRange"
                            },
                            "minLength": 1
                        },
                        "outlineWeightMax": {
                            "description": "maximum weight for areas to be considered as outlines",
                            "type": "integer",
                            "minimum": 0
                        },
                        "outlineHSVRanges": {
                            "description": "HSV ranges for areas to be considered as outlines",
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/HSVRange"
                            },
                            "minLength": 1
                        },
                        "boundCompensation": {
                            "description": "extra width applied during the text-outline mutual filtering process",
                            "type": "integer",
                            "minimum": 0
                        },
                        "sobelThreshold": {
                            "description": "threshold for the Sobel edge detection",
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 255
                        },
                        "nestingSuppression": {
                            "description": "suppression weight of the nested outline",
                            "type": "integer",
                            "minimum": 0
                        },
                        "featureThreshold": {
                            "description": "minimum feature weight for a frame to be considered containing subtitles",
                            "type": "number",
                            "minimum": 0
                        },
                        "featureJumpThreshold": {
                            "description": "maximum feature difference between frames to be considered as a jump",
                            "type": "number",
                            "minimum": 0
                        },
                        "featureJumpStddevThreshold": {
                            "description": "maximum standard deviation of feature difference between frames to be considered the same",
                            "type": "number",
                            "minimum": 0
                        },
                        "debugLevel": {
                            "description": "setting it to 1-3 will show different intermediate step images to the debug window",
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 3
                        }
                    },
                    "required": [
                        "dialogRect",
                        "fastMode",
                        "textWeightMin",
                        "textWeightMax",
                        "textHSVRanges",
                        "outlineWeightMax",
                        "outlineHSVRanges",
                        "boundCompensation",
                        "sobelThreshold",
                        "nestingSuppression",
                        "featureThreshold",
                        "featureJumpThreshold",
                        "featureJumpStddevThreshold",
                        "debugLevel"
                    ],
                    "additionalProperties": false
                }
            }
        },
        "bcs": {
            "description": "Box colour stat strategy",
            "type": "object",
            "patternProperties": {
                ".*": {
                    "description": "a preset for strategy bcs",
                    "type": "object",
                    "properties": {
                        "dialogRect": {
                            "description": "rectangle of the detected dialog area",
                            "$ref": "#/$defs/ratioRectangle"
                        },
                        "sobelThreshold": {
                            "description": "threshold for the Sobel edge detection",
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 255
                        },
                        "featureThreshold": {
                            "description": "minimum feature weight for a frame to be considered containing subtitles",
                            "type": "number",
                            "minimum": 0
                        },
                        "featureJumpThreshold": {
                            "description": "maximum feature difference between frames to be considered as a jump",
                            "type": "number",
                            "minimum": 0
                        },
                        "boxVerticalExpansion": {
                            "description": "vertical expansion ratio of the detected dialog box",
                            "type": "number",
                            "minimum": 0
                        },
                        "nonMajorBoxSuppressionMaxRatio": {
                            "description": "boxes with a ratio (over all boxes) lower than this will be suppressed",
                            "type": "number",
                            "minimum": 0
                        },
                        "nonMajorBoxSuppressionMinRank": {
                            "description": "but at least this number of boxes will be kept",
                            "type": "integer",
                            "minimum": 1
                        },
                        "minCcAreaRatio": {
                            "description": "minimum ratio (over all connected components) to be considered text area candidate",
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "maxCcAreaRatio": {
                            "description": "maximum ratio (over all connected components) to be considered text area candidate",
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "minCcFinalMean": {
                            "description": "minimum mean of connected component colour for a frame to be considered containing subtitles",
                            "type": "number",
                            "minimum": 0
                        },
                        "maxCcStddev": {
                            "description": "maximum standard deviation for a connected component to be considered consistent enough to be text",
                            "type": "number",
                            "minimum": 0
                        },
                        "colourTolerance": {
                            "description": "distance from the selected mean colour to be filtered for text",
                            "type": "integer",
                            "minimum": 0
                        },
                        "clusterThreshold": {
                            "description": "maximum distance threshold for hierarchical clustering",
                            "type": "number",
                            "minimum": 0
                        },
                        "minColourAreaRatio": {
                            "description": "minimum ratio (over all connected components) to be further considered text area candidate",
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "maxGreyscalePenalty": {
                            "description": "a colour that is right on the greyscale axis will be penalized by this factor for its tendency to be selected",
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "iirPassDenoiseMinTime": {
                            "description": "minimum time (in milliseconds) for an interval to be kept",
                            "type": "integer",
                            "minimum": 0
                        },
                        "debugLevel": {
                            "description": "1 shows raw text boxes, 2 shows filtered text boxes, 3 shows accepted connected components, 4 shows text strokes",
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 4
                        }
                    },
                    "required": [
                        "dialogRect",
                        "sobelThreshold",
                        "featureThreshold",
                        "featureJumpThreshold",
                        "minCcAreaRatio",
                        "maxCcAreaRatio",
                        "minCcFinalMean",
                        "maxCcStddev",
                        "colourTolerance",
                        "clusterThreshold",
                        "minColourAreaRatio",
                        "maxGreyscalePenalty",
                        "iirPassDenoiseMinTime",
                        "debugLevel"
                    ],
                    "additionalProperties": false
                }
            }
        },
        "dtd": {
            "description": "Diff text detection strategy",
            "type": "object",
            "patternProperties": {
                ".*": {
                    "description": "a preset for strategy dtd",
                    "type": "object",
                    "properties": {
                        "dialogRect": {
                            "description": "rectangle of the detected dialog area",
                            "$ref": "#/$defs/ratioRectangle"
                        },
                        "featureThreshold": {
                            "description": "minimum feature weight for a frame to be considered containing subtitles",
                            "type": "number",
                            "minimum": 0
                        },
                        "boxExpansion": {
                            "description": "expansion ratio of the detected dialog box",
                            "type": "number",
                            "minimum": 0
                        },
                        "nonMajorBoxSuppressionMaxRatio": {
                            "description": "boxes with a ratio (over the biggest box) lower than this will be suppressed",
                            "type": "number",
                            "minimum": 0
                        },
                        "colourTolerance": {
                            "description": "distance from the selected mean colour to be filtered for text",
                            "type": "integer",
                            "minimum": 0
                        },
                        "maxGreyscalePenalty": {
                            "description": "a colour that is right on the greyscale axis will be penalized by this factor for its tendency to be selected",
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "iirPassDenoiseMinTime": {
                            "description": "minimum time (in milliseconds) for an interval to be kept",
                            "type": "integer",
                            "minimum": 0
                        },
                        "enableTypewriter": {
                            "description": "whether to activate typewriter subtitle support; when false, behaviour is identical to the pre-typewriter algorithm",
                            "type": "boolean"
                        },
                        "typewriterXCoverageThreshold": {
                            "description": "minimum old-mask X projection coverage by the intersection mask for a frame pair to be considered a typewriter candidate",
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "typewriterAreaRatioThreshold" : {
                            "description": "minimum ratio of the new box area to the old mask area for a frame pair to be considered a typewriter candidate",
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "enableShortCircuit": {
                            "description": "allow early decisions before reaching the final OCR stage",
                            "type": "boolean"
                        },
                        "debugLevel": {
                            "description": "1 saves logs",
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1
                        }
                    },
                    "required": [
                        "dialogRect",
                        "featureThreshold",
                        "colourTolerance",
                        "iirPassDenoiseMinTime",
                        "enableTypewriter",
                        "typewriterXCoverageThreshold",
                        "typewriterAreaRatioThreshold",
                        "enableShortCircuit",
                        "debugLevel"
                    ],
                    "additionalProperties": false
                }
            }
        },
        "engine": {
            "description": "which frame sampling pipeline to use",
            "type": "string",
            "enum": [
                "framewise",
                "speculative"
            ]
        },
        "framewise": {
            "description": "samples every frame or every n-th frame",
            "type": "object",
            "properties": {
                "sampleInterval": {
                    "description": "in how many frames to sample a frame",
                    "type": "integer",
                    "minimum": 1
                },
                "debug": {
                    "description": "whether to show debug information",
                    "type": "boolean"
                },
                "debugPyrDown": {
                    "description": "how many times to downscale the debug window",
                    "type": "number",
                    "minimum": 0
                }
            },
            "required": [
                "sampleInterval",
                "debug",
                "debugPyrDown"
            ],
            "additionalProperties": false
        },
        "speculative": {
            "description": "skips frames where subtitles do not change and performs binary search for change points",
            "type": "object",
            "properties": {
                "emptyGapForceCheck": {
                    "description": "in how many milliseconds to force check for existence of subtitles",
                    "type": "number",
                    "minimum": 0
                },
                "debug": {
                    "description": "whether to show debug information",
                    "type": "boolean"
                }
            },
            "required": [
                "emptyGapForceCheck",
                "debug"
            ],
            "additionalProperties": false
        },
        "extraJobs": {
            "description": "list of extra jobs to perform after subtitle extraction",
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "ocr": {
            "type": "object",
            "properties": {
                "standaloneOutput": {
                    "type": "boolean",
                    "description": "whether to output OCR results to a standalone file instead of embedding them in the subtitle file"
                },
                "standaloneOutputSuffix": {
                    "type": "string",
                    "description": "suffix for the standalone OCR output file"
                },
                "separator": {
                    "type": "string",
                    "description": "separator used in OCR output"
                },
                "doPaddle": {
                    "type": "boolean",
                    "description": "whether to perform OCR using PaddleOCR"
                },
                "nonMajorBoxSuppressionMaxRatio": {
                    "description": "boxes with a ratio (over all boxes) lower than this will be suppressed",
                    "type": "number",
                    "minimum": 0
                },
                "nonMajorBoxSuppressionMinRank": {
                    "description": "but at least this number of boxes will be kept",
                    "type": "integer",
                    "minimum": 1
                },
                "doTesseract": {
                    "type": "boolean",
                    "description": "whether to perform OCR using Tesseract"
                },
                "tesseractLang": {
                    "type": "string",
                    "description": "language setting for Tesseract OCR (e.g., jpn for Japanese)"
                }
            },
            "required": [
                "standaloneOutput",
                "standaloneOutputSuffix",
                "separator",
                "doPaddle",
                "nonMajorBoxSuppressionMaxRatio",
                "nonMajorBoxSuppressionMinRank",
                "doTesseract",
                "tesseractLang"
            ],
            "additionalProperties": false
        },
        "sty": {
            "description": "Automatic subtitle style classification by colour clustering",
            "type": "object",
            "properties": {
                "clusterDistThreshold": {
                    "type": "number",
                    "description": "distance threshold for agglomerative clustering; set to 0 or negative for auto (inconsistency criterion)"
                },
                "minIntervalCount": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "minimum number of intervals a cluster must have to be assigned a named style"
                },
                "nonMajorBoxSuppressionMaxRatio": {
                    "description": "boxes with a ratio (over all boxes) lower than this will be suppressed",
                    "type": "number",
                    "minimum": 0
                },
                "nonMajorBoxSuppressionMinRank": {
                    "description": "but at least this number of boxes will be kept",
                    "type": "integer",
                    "minimum": 1
                },
                "sobelThreshold": {
                    "description": "threshold for the Sobel edge detection",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                },
                "minCcAreaRatio": {
                    "description": "minimum ratio (over all connected components) to be considered text area candidate",
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "maxCcAreaRatio": {
                    "description": "maximum ratio (over all connected components) to be considered text area candidate",
                    "type": "number",
